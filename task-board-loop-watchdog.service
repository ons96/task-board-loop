[Unit]
Description=task-board-loop watchdog (identity-safe stale process termination)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=HEARTBEAT_FILE=/tmp/agent-loop.heartbeat
Environment=LOOP_PID_FILE=/tmp/task-board-loop.pid
Environment=WATCHDOG_MAX_AGE=1800
ExecStart=%h/task-board-loop/task-board-loop-watchdog.sh

[Install]
WantedBy=default.target
